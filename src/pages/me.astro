---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MeTimeline from '@/components/MeTimeline';
import { siteConfig } from '@/site.config';
import portrait from '@/assets/me/portrait.jpg';

const allTimeline = await getCollection('timeline');
const items = allTimeline
  .sort((a: CollectionEntry<'timeline'>, b: CollectionEntry<'timeline'>) => a.data.startDate.localeCompare(b.data.startDate))
  .map((t: CollectionEntry<'timeline'>) => ({
    title: t.data.title,
    org: t.data.org,
    kind: t.data.kind,
    description: t.data.description,
    startDate: t.data.startDate,
    endDate: t.data.endDate,
  }));
---

<BaseLayout title="Me" description="Paul Witkowski's background: education, work, teaching, and volunteering.">
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-16 md:px-12">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <Image
          src={portrait}
          alt="Portrait of Paul Witkowski"
          width={480}
          height={480}
          loading="eager"
          class="h-80 w-80 rounded-full object-cover"
        />
      </div>
      <div class="md:col-span-8">
        <h1 class="font-display text-4xl font-bold text-foreground">Paul Witkowski</h1>
        <p class="mt-6 max-w-2xl text-foreground/70">
          I'm a Master's student in AI and Systems Engineering at EPITA (SCIA major), based in Paris. I build AI
          systems end to end: the model, the data pipeline underneath it, and the infrastructure that runs it, and
          I go low enough to write compilers and shells by hand when I want to actually understand what's happening
          under a tool I use every day. That range shows up across my work: a computer vision pipeline now running
          daily in hospital diagnostics at Hôpital des Quinze-Vingts and around the world, a data architecture built for IoT-scale
          wildfire detection, and a Tiger compiler and POSIX shell built from scratch.
        </p>
        <p class="mt-4 max-w-2xl text-foreground/70">
          Outside coursework, I've taught as a C#/OCaml teaching assistant at EPITA, spent a semester on exchange at
          Boston University, and interned in AI and computer vision engineering at CNRS. I participate at many hackathons and I currently volunteer with
          Prologin, running coding workshops for middle and high school students.
        </p>
        <a
          href={siteConfig.cvPath}
          class="mt-8 inline-block rounded-control bg-accent px-5 py-3 text-sm font-medium text-white"
        >
          Download CV
        </a>
      </div>
    </div>
  </section>

  <section>
    <MeTimeline client:visible items={items} />
  </section>
</BaseLayout>
