---
import Navbar from '@/components/Navbar';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/site.config';
import { noFlashThemeScript } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = siteConfig.description, ogImage = siteConfig.ogImage } = Astro.props;
const pageTitle = `${title} — ${siteConfig.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageUrl = new URL(ogImage, siteConfig.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline set:html={noFlashThemeScript} />

    <!-- Analytics insertion point: cookie-less, EU/GDPR-friendly tool (e.g. Plausible/Umami) goes here. -->
  </head>
  <body>
    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
