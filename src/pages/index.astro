---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Spotlight } from '@/components/ui/spotlight';
import Hero from '@/components/Hero';
import FlagshipGrid from '@/components/FlagshipGrid';
import { siteConfig } from '@/site.config';
import linksData from '@/content/links.json';

const links = linksData as { id: string; label: string; url: string; icon: string }[];
const allProjects = await getCollection('projects');
const flagship = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.flagship)
  .sort(
    (a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
      (a.data.flagshipOrder ?? 0) - (b.data.flagshipOrder ?? 0),
  )
  .map((p: CollectionEntry<'projects'>) => ({
    title: p.data.title,
    summary: p.data.summary,
    stack: p.data.stack,
    githubUrl: p.data.githubUrl,
    category: p.data.category,
    image: p.data.image,
    flagshipOrder: p.data.flagshipOrder,
  }));
---

<BaseLayout title="Home">
  <section class="relative overflow-hidden px-6 pt-40 pb-24 md:px-12">
    <Spotlight className="-top-40 left-0 md:left-40" fill="#95122C" />

    <div class="relative mx-auto grid max-w-6xl grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <Hero
          client:load
          tagline={siteConfig.tagline}
          description={siteConfig.description}
          cvPath={siteConfig.cvPath}
          links={links}
        />
      </div>
      <div class="md:col-span-5"></div>
    </div>
  </section>

  <section class="px-6 pb-24 md:px-12">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-2xl font-semibold text-foreground">Flagship projects</h2>
      <div class="mt-8">
        <FlagshipGrid client:visible projects={flagship} />
      </div>
      <div class="mt-10">
        <a
          href="/projects"
          class="rounded-control border border-foreground/20 px-5 py-3 text-sm font-medium text-foreground"
        >
          View all projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
