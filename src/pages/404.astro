---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="mx-auto flex min-h-[60vh] max-w-6xl flex-col items-start justify-center px-6 md:px-12">
    <h1 class="font-display text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-foreground/70">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 rounded-control bg-accent px-4 py-2 text-sm font-medium text-white">
      Back home
    </a>
  </section>
</BaseLayout>
