---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm';
import { siteConfig } from '@/site.config';
import linksData from '@/content/links.json';

const links = linksData as { id: string; label: string; url: string; icon: string }[];
---

<BaseLayout title="Contact" description="Get in touch with Paul Witkowski.">
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-24 md:px-12">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <h1 class="font-display text-4xl font-bold text-foreground">Contact</h1>
        <p class="mt-4 max-w-sm text-foreground/70">
          Reach out directly, or use the form.
        </p>
        <div class="mt-8 flex flex-col gap-3 text-sm">
          {links.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer" class="text-foreground/70 hover:text-foreground">
              {link.label}
            </a>
          ))}
        </div>
        <a
          href={siteConfig.cvPath}
          class="mt-8 inline-block rounded-control bg-accent px-5 py-3 text-sm font-medium text-white"
        >
          Download CV
        </a>
      </div>
      <div class="md:col-span-7">
        <ContactForm client:load formspreeEndpoint={siteConfig.formspreeEndpoint} />
      </div>
    </div>
  </section>
</BaseLayout>
