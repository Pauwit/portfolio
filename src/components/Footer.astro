---
import linksData from '@/content/links.json';

const links = linksData as { id: string; label: string; url: string; icon: string }[];
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-foreground/10 bg-background px-6 py-10 md:px-12">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 text-sm text-foreground/60 md:flex-row md:items-center">
    <p>&copy; {year} Paul Witkowski. Built with Astro.</p>
    <nav class="flex gap-6">
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer" class="hover:text-foreground">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
